APP_NAME="Furniture CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dubai
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- DATABASE (XAMPP MySQL defaults) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=box_motorsports_crm
DB_USERNAME=root
DB_PASSWORD=

# ---- SESSION / CACHE / QUEUE ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- MAIL (use log driver locally; emails appear in storage/logs) ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="crm@boxmotorsports.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---- WEBHOOK SECRETS (fallbacks; real values stored in Integrations screen) ----
WEBHOOK_SECRET_GENERIC=
WEBHOOK_SECRET_JOTFORM=
WEBHOOK_SECRET_GOOGLE_FORM=
WEBHOOK_SECRET_WEBSITE=
WEBHOOK_SECRET_WHATSAPP=
WEBHOOK_SECRET_EMAIL=

# ---- OPTIONAL EXTERNAL NOTIFICATIONS ----
NOTIFY_SLACK_WEBHOOK=
NOTIFY_DISCORD_WEBHOOK=

VITE_APP_NAME="${APP_NAME}"

# ---- META LEAD ADS (Phase 5) ----
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# ---- GOOGLE LEADS (Phase 5) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_CUSTOMER_ID=
GOOGLE_REFRESH_TOKEN=
GOOGLE_LEADS_WEBHOOK_SECRET=

GOOGLE_SHEETS_SYNC_URL = 
