APP_NAME="Meuble CRM"
APP_ENV=production
APP_KEY=base64:7eT+2mBqW90vUv/57o2+vj6qQcE309zC9pP65+6846U=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dubai
APP_URL=https://meuble.socializo.co

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- DATABASE (Enter your cPanel MySQL Database Details) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_db_name
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password

# ---- SESSION / CACHE / QUEUE ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# ---- MAIL ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@socializo.co"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
